# Browser-exposed base URL for the API.
# Keep /api here. In local development you can leave the default /api
# and let the Vite proxy forward requests to the Express server.
VITE_API_URL=https://freshcart-e-commerce-mern.onrender.com/api
# Used only by the Vite dev server proxy (not exposed to application code).
VITE_API_PROXY_TARGET=http://localhost:5000
