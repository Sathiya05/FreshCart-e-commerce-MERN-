NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CLIENT_URL=http://localhost:5173,http://localhost:4173,https://freshcart-e-commerce-mern.pages.dev

# MongoDB Atlas connection string. Replace the placeholders.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=FreshCart
MONGODB_DB_NAME=freshcart

# Basic API rate limit: 100 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT authentication. Use long random values in production.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# HttpOnly cookie settings. Use secure=true and sameSite=none for HTTPS cross-site.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Google sign-in for the login page. This is a public OAuth client ID, not a
# secret; add the storefront origin under "Authorized JavaScript origins" in
# Google Cloud Console. Leave blank to hide the working Google button.
# The same value must be set on Render as GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# One-time bootstrap account for /api/admin routes: npm run create-admin
ADMIN_NAME=FreshCart Admin
ADMIN_EMAIL=admin@freshcart.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Razorpay test-mode credentials. Never use live keys in local development.
# Keep these out of Git; server/.env is ignored.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
RAZORPAY_CURRENCY=INR

# AI shopping assistant (Google Gemini, server-side only; never expose secrets in the browser).
# Leave GEMINI_API_KEY blank to keep the assistant gracefully disabled.
# Use the exact variable names below in local .env and on Render.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=20000
AI_MAX_TOOL_ROUNDS=6
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30

# WhatsApp is click-to-chat only. Set the public business number in
# client/.env as VITE_WHATSAPP_PHONE; no Meta credentials belong on the server.

# Phase 6 — S3 product image uploads.
# Leave AWS credentials blank when running on an IAM-role-backed host and set
# AWS_USE_IAM_ROLE=true. Uploads are disabled gracefully when unset.
AWS_REGION=ap-south-1
S3_BUCKET=your-freshcart-bucket
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_IAM_ROLE=false
